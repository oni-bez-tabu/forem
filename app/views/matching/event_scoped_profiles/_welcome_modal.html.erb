<div
  id="welcome-modal-<%= receiver_profile.id %>"
  class="welcome-modal"
  data-welcome-modal
  data-welcomes-url="<%= matching_welcomes_path %>"
  data-meetup-id="<%= meetup.id %>"
  data-receiver-id="<%= receiver_profile.id %>"
  style="display: none; position: fixed; inset: 0; z-index: 1000; background: rgba(0,0,0,0.55); align-items: center; justify-content: center;"
>
  <div class="crayons-card p-6" style="max-width: 520px; width: calc(100% - 32px); max-height: 90vh; overflow-y: auto;">
    <h2 class="crayons-subtitle mb-3"><%= t("matching.welcomes.modal.heading") %></h2>

    <%# State 1: compose %>
    <div data-welcome-state="compose">
      <p class="fs-xs color-base-60 mb-2"><%= t("matching.welcomes.modal.preview_label") %></p>
      <div class="p-3 mb-4" style="background: var(--card-secondary-bg, #f5f5f5); border-radius: 6px; white-space: pre-wrap; font-family: monospace; font-size: 13px;"><%= welcome_body %></div>

      <div class="p-3 mb-4" style="border: 1px solid var(--card-border, #ddd); border-radius: 6px;">
        <p class="fs-s mb-2"><strong><%= t("matching.welcomes.modal.what_happens_heading") %></strong></p>
        <ul class="fs-xs color-base-70" style="list-style: disc; padding-left: 20px; margin: 0;">
          <li><%= t("matching.welcomes.modal.what_happens.l1") %></li>
          <li><%= t("matching.welcomes.modal.what_happens.l2") %></li>
          <li><%= t("matching.welcomes.modal.what_happens.l3") %></li>
        </ul>
      </div>

      <p class="fs-xs color-accent-warning mb-4"><%= t("matching.welcomes.modal.once_warning") %></p>

      <div class="flex gap-2 justify-end">
        <button type="button" class="c-btn" data-welcome-close><%= t("matching.welcomes.modal.cancel") %></button>
        <button type="button" class="c-btn c-btn--primary" data-welcome-send><%= t("matching.welcomes.modal.send") %></button>
      </div>
    </div>

    <%# State 2: sending %>
    <div data-welcome-state="sending" style="display: none; text-align: center; padding: 24px 0;">
      <div style="font-size: 48px; margin-bottom: 12px;">✉️</div>
      <p><%= t("matching.welcomes.modal.sending") %></p>
    </div>

    <%# State 3: success %>
    <div data-welcome-state="success" style="display: none; text-align: center; padding: 24px 0;">
      <div style="font-size: 48px; margin-bottom: 12px;">✓</div>
      <h3 class="crayons-subtitle mb-2"><%= t("matching.welcomes.modal.success_heading") %></h3>
      <p class="fs-s color-base-70 mb-4"><%= t("matching.welcomes.modal.success_body") %></p>
      <button type="button" class="c-btn c-btn--primary" data-welcome-close><%= t("matching.welcomes.modal.close") %></button>
    </div>

    <%# State 4: error %>
    <div data-welcome-state="error" style="display: none; text-align: center; padding: 24px 0;">
      <p class="color-accent-danger" data-welcome-error-text></p>
      <button type="button" class="c-btn mt-3" data-welcome-close><%= t("matching.welcomes.modal.close") %></button>
    </div>
  </div>
</div>

<script>
  (function() {
    var modal = document.getElementById("welcome-modal-<%= receiver_profile.id %>");
    if (!modal) return;
    var token = document.querySelector("meta[name='csrf-token']");
    var csrf = token ? token.getAttribute("content") : "";

    function setState(name) {
      modal.querySelectorAll("[data-welcome-state]").forEach(function(el) {
        el.style.display = el.dataset.welcomeState === name ? "" : "none";
      });
      // sending/success/error → tweak overall layout (textAlign center)
      if (name === "compose") {
        modal.querySelector('[data-welcome-state="compose"]').style.display = "block";
      }
    }
    function open() { modal.style.display = "flex"; setState("compose"); }
    function close() { modal.style.display = "none"; }

    document.querySelectorAll('[data-welcome-open][data-target="#welcome-modal-<%= receiver_profile.id %>"]').forEach(function(btn) {
      btn.addEventListener("click", open);
    });
    modal.querySelectorAll("[data-welcome-close]").forEach(function(btn) {
      btn.addEventListener("click", close);
    });
    modal.addEventListener("click", function(e) { if (e.target === modal) close(); });

    var sendBtn = modal.querySelector("[data-welcome-send]");
    if (!sendBtn) return;
    sendBtn.addEventListener("click", function() {
      setState("sending");
      fetch(modal.dataset.welcomesUrl, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "X-CSRF-Token": csrf
        },
        credentials: "same-origin",
        body: JSON.stringify({
          meetup_id: parseInt(modal.dataset.meetupId, 10),
          receiver_profile_id: parseInt(modal.dataset.receiverId, 10)
        })
      }).then(function(r) {
        return r.json().then(function(json) { return { status: r.status, json: json }; });
      }).then(function(result) {
        if (result.status === 201) {
          setState("success");
        } else {
          var msg = result.json.error || (result.json.errors && result.json.errors.join(", ")) || "Unknown error";
          var errEl = modal.querySelector("[data-welcome-error-text]");
          if (errEl) errEl.textContent = msg;
          setState("error");
        }
      }).catch(function() {
        var errEl = modal.querySelector("[data-welcome-error-text]");
        if (errEl) errEl.textContent = "Network error";
        setState("error");
      });
    });
  })();
</script>
