<div class="mt-4">
  <p class="fs-xs color-base-60 mb-2"><%= t("matching.matches.blurred_teaser") %></p>
  <div class="grid grid-cols-2 gap-3" style="filter: blur(8px); pointer-events: none; opacity: 0.7;">
    <% 2.times do %>
      <div class="crayons-card crayons-card--secondary p-3">
        <div class="flex gap-3">
          <div style="width: 80px; height: 100px; background: var(--card-secondary-bg, #ccc); border-radius: 6px;"></div>
          <div class="flex-1">
            <div style="height: 18px; background: var(--card-secondary-bg, #ccc); border-radius: 4px; width: 80px;"></div>
            <div style="height: 14px; background: var(--card-secondary-bg, #ccc); border-radius: 4px; width: 100%; margin-top: 8px;"></div>
            <div style="height: 14px; background: var(--card-secondary-bg, #ccc); border-radius: 4px; width: 60%; margin-top: 4px;"></div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
