<% title t("matching.show.title") %>

<div class="crayons-layout crayons-layout--limited-width">
  <header class="mb-6">
    <h1 class="crayons-title">✨ <%= t("matching.show.title") %></h1>
    <p class="crayons-subtitle"><%= t("matching.show.subtitle") %></p>
  </header>

  <% if @profile.nil? %>
    <div class="crayons-card p-6 text-center">
      <h2 class="crayons-subtitle mb-3"><%= t("matching.show.no_profile_title") %></h2>
      <p class="mb-4"><%= t("matching.show.no_profile_body") %></p>
      <% if current_user.suspended? %>
        <p class="color-base-60 fs-s"><%= t("matching.profiles.suspended_blocked") %></p>
      <% else %>
        <%= link_to t("matching.show.create_profile"), matching_onboarding_path, class: "crayons-btn" %>
      <% end %>
    </div>

  <% else %>
    <%# Hifi-style header card: large portrait, h1 + status pill, identity/city/match-count chips, italic bio quote, edit btn %>
    <div class="crayons-card mb-6" style="padding: 28px;">
      <div class="flex gap-5 items-start flex-wrap">
        <% if @profile.photo.present? %>
          <img src="<%= @profile.photo.url %>" alt="<%= current_user.username %>" style="width: 120px; height: 150px; object-fit: cover; border-radius: 8px; flex: 0 0 120px;">
        <% end %>
        <div class="flex-1" style="min-width: 240px;">
          <div class="flex items-baseline gap-3 flex-wrap mb-2">
            <h1 class="crayons-title" style="margin: 0; font-size: 24px;"><%= t("matching.show.profile_title") %></h1>
            <% if @profile.visible_to_others? %>
              <span class="crayons-indicator" style="background: var(--accent-brand, #6366f1); color: #fff; font-weight: 700; padding: 4px 10px; font-size: 12px;">
                <%= t("matching.show.profile_active_pill") %>
              </span>
            <% elsif @profile.pending? %>
              <span class="crayons-indicator crayons-indicator--warning"><%= t("matching.moderation.pending") %></span>
            <% elsif @profile.rejected? %>
              <span class="crayons-indicator crayons-indicator--danger"><%= t("matching.moderation.rejected") %></span>
            <% end %>
            <% unless @profile.is_active? %>
              <span class="crayons-indicator crayons-indicator--warning"><%= t("matching.show.deactivated") %></span>
            <% end %>
          </div>
          <div class="flex gap-2 flex-wrap mb-2">
            <span class="crayons-indicator crayons-indicator--accent"><%= t("matching.identity_types.#{@profile.identity_type}") %></span>
            <span class="crayons-indicator">📍 <%= @profile.city.name %></span>
            <% if @new_matches_count.to_i.positive? %>
              <span class="crayons-indicator" style="background: var(--accent-brand-lighter, #ede9fe); color: var(--accent-brand, #6366f1); font-weight: 600;">
                <%= t("matching.show.matches_count", count: @new_matches_count) %>
              </span>
            <% end %>
          </div>
          <% if @profile.bio.present? %>
            <p class="fs-base color-base-80 mb-1" style="font-style: italic;">"<%= @profile.bio %>"</p>
          <% end %>
          <% if @profile.moderation_reason.present? %>
            <p class="fs-s color-base-60 mb-1"><%= t("matching.show.rejection_reason") %>: <%= @profile.moderation_reason %></p>
          <% end %>
          <p class="fs-xs color-base-60 mt-1">🔒 <%= t("matching.show.privacy_hint") %></p>
        </div>
        <div>
          <%= link_to t("matching.show.manage_profile"), "/settings/matching", class: "crayons-btn crayons-btn--outlined crayons-btn--s" %>
        </div>
      </div>
    </div>

    <% if @profile.visible_to_others? %>
      <div class="flex between items-baseline flex-wrap mb-3">
        <h2 class="crayons-subtitle-1" style="margin: 0;"><%= t("matching.timeline.heading") %></h2>
        <span class="fs-s color-base-60"><%= t("matching.timeline.subheading") %></span>
      </div>
      <%= render "timeline_feed", events: @timeline, recommendations: @recommendations %>
    <% else %>
      <div class="crayons-card p-6 text-center">
        <% if @profile.pending? %>
          <p><%= t("matching.show.pending_explanation") %></p>
        <% elsif @profile.rejected? %>
          <p><%= t("matching.show.rejected_explanation") %></p>
        <% elsif !@profile.is_active? %>
          <p><%= t("matching.show.deactivated_explanation") %></p>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
