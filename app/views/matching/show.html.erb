<% title t("matching.show.title") %>

<div class="crayons-layout crayons-layout--limited-width">
  <header class="mb-6">
    <h1 class="crayons-title">✨ <%= t("matching.show.title") %></h1>
    <p class="crayons-subtitle"><%= t("matching.show.subtitle") %></p>
  </header>

  <% if @profile.nil? %>
    <div class="crayons-card p-6 text-center">
      <h2 class="crayons-subtitle mb-3"><%= t("matching.show.no_profile_title") %></h2>
      <p class="mb-4"><%= t("matching.show.no_profile_body") %></p>
      <% if current_user.suspended? %>
        <p class="color-base-60 fs-s"><%= t("matching.profiles.suspended_blocked") %></p>
      <% else %>
        <%= link_to t("matching.show.create_profile"), matching_onboarding_path, class: "crayons-btn" %>
      <% end %>
    </div>

  <% else %>
    <%# Compact header — small portrait + identity/city + manage link %>
    <div class="crayons-card p-4 mb-4">
      <div class="flex gap-3 items-center">
        <% if @profile.photo.present? %>
          <img src="<%= @profile.photo.url %>" alt="<%= current_user.username %>" style="width: 64px; height: 64px; object-fit: cover; border-radius: 50%; flex: 0 0 64px;">
        <% end %>
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="crayons-indicator crayons-indicator--accent"><%= t("matching.identity_types.#{@profile.identity_type}") %></span>
            <span class="crayons-indicator">📍 <%= @profile.city.name %></span>
            <%= render "matching/moderation_badge", profile: @profile %>
            <% unless @profile.is_active? %>
              <span class="crayons-indicator crayons-indicator--warning"><%= t("matching.show.deactivated") %></span>
            <% end %>
          </div>
          <% if @profile.moderation_reason.present? %>
            <p class="fs-s color-base-60 mt-1"><%= t("matching.show.rejection_reason") %>: <%= @profile.moderation_reason %></p>
          <% end %>
        </div>
        <div>
          <%= link_to t("matching.show.manage_profile"), "/settings/matching", class: "crayons-btn crayons-btn--outlined crayons-btn--s" %>
        </div>
      </div>
    </div>

    <% if @profile.visible_to_others? %>
      <h2 class="crayons-subtitle-1 mb-3"><%= t("matching.timeline.heading") %></h2>
      <%= render "timeline_feed", events: @timeline, recommendations: @recommendations %>
    <% else %>
      <div class="crayons-card p-6 text-center">
        <% if @profile.pending? %>
          <p><%= t("matching.show.pending_explanation") %></p>
        <% elsif @profile.rejected? %>
          <p><%= t("matching.show.rejected_explanation") %></p>
        <% elsif !@profile.is_active? %>
          <p><%= t("matching.show.deactivated_explanation") %></p>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
