<% title t("matching.show.title") %>

<%# Pełny Preact SPA — `/matching` to prywatny dashboard, więc brak
    server-side rendered content (SEO nie potrzebne). Preact bierze
    #matching-app, fetchuje /api/matching/dashboard, renderuje.
    Brak profilu → server redirektuje na /matching/onboarding (gate w
    MatchingController#show); ten widok serwuje się tylko dla zalogowa-
    nych userów którzy profil mają. %>
<div class="crayons-layout crayons-layout--limited-width">
  <div id="matching-app"
       data-onboarding-url="<%= matching_onboarding_path %>"
       data-settings-url="/settings/matching">
  </div>
</div>

<%= javascript_include_tag "matchingDashboard",
                           "matchingDeclarationModal",
                           "matchingRsvp",
                           "matchingBoost",
                           "matchingWelcome",
                           defer: true %>
