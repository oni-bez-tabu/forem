<div class="p-3">
  <p class="fs-xs color-accent-brand mb-1" style="text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">
    ✨ <%= t("matching.recommendations.label") %>
  </p>
  <%= link_to meetup_path(meetup), class: "c-link", style: "display: block; text-decoration: none; color: inherit;" do %>
    <div class="flex gap-3 items-center">
      <% if meetup.banner.present? %>
        <img src="<%= meetup.banner.url %>" alt="" style="width: 56px; height: 56px; object-fit: cover; border-radius: 6px; flex: 0 0 56px;">
      <% else %>
        <% gradient = MeetupsHelper::BANNER_GRADIENTS[meetup.banner_gradient] || MeetupsHelper::BANNER_GRADIENTS.fetch("dusk") %>
        <span style="width: 56px; height: 56px; flex: 0 0 56px; display: block; background: <%= gradient %>; border-radius: 6px;"></span>
      <% end %>
      <div class="flex-1 min-w-0">
        <div class="fs-base" style="font-weight: 600;"><%= meetup.name %></div>
        <div class="fs-xs color-base-60">
          📅 <%= I18n.l(meetup.start_at, format: :short) %>
          <% if meetup.venue_city %> · 📍 <%= meetup.venue_city.name %><% end %>
        </div>
      </div>
      <span class="fs-s color-accent-brand">→</span>
    </div>
  <% end %>
</div>
