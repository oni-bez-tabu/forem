<%# Full recommendation card per mockup E8 (screens.jsx:868-894):
    banner strip on the left, dashed magenta border, "Polecane dla ciebie" tag,
    title + meta, "Bo: X osób z twoich preferencji" explanation, two CTAs. %>
<% meetup = recommendation.meetup %>
<% breakdown = recommendation.identity_breakdown %>
<% breakdown_parts = breakdown.map { |id_type, n| "#{n} #{t("matching.identity_types_plural.#{id_type}", default: id_type)}" }.first(3) %>
<% gradient = MeetupsHelper::BANNER_GRADIENTS[meetup.banner_gradient] || MeetupsHelper::BANNER_GRADIENTS.fetch("dusk") %>

<div class="crayons-card" style="display: flex; gap: 0; overflow: hidden; border-style: dashed; border-color: var(--accent-brand, #6366f1); background: rgba(99,102,241,0.03);">
  <% if meetup.banner.present? %>
    <img src="<%= meetup.banner.url %>" alt="" style="width: 140px; flex: 0 0 140px; align-self: stretch; object-fit: cover; display: block;">
  <% else %>
    <span style="width: 140px; flex: 0 0 140px; align-self: stretch; min-height: 100%; display: block; background: <%= gradient %>;"></span>
  <% end %>

  <div style="flex: 1 1 auto; padding: 14px 16px; min-width: 0;">
    <div class="flex items-baseline gap-2 flex-wrap" style="justify-content: space-between;">
      <span class="fs-xs color-accent-brand" style="font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">
        ✨ <%= t("matching.recommendations.label") %>
      </span>
    </div>

    <h3 class="fs-l mt-1" style="margin: 4px 0 0; font-weight: 700;">
      <%= link_to meetup.name, meetup_path(meetup), class: "c-link", style: "color: inherit; text-decoration: none;" %>
    </h3>
    <p class="fs-s color-base-70" style="margin: 2px 0 0;">
      📅 <%= I18n.l(meetup.start_at, format: :short) %>
      <% if meetup.venue_city %> · 📍 <%= meetup.venue_city.name %><% end %>
    </p>

    <% if recommendation.active_count.positive? %>
      <p class="fs-s color-base-80 mt-2" style="margin-top: 10px;">
        <strong><%= t("matching.recommendations.reason_lead") %>:</strong>
        <%= t("matching.recommendations.reason_pool_count", count: recommendation.active_count) %>
      </p>
      <% if breakdown_parts.any? || recommendation.open_to_meet_count.positive? %>
        <p class="fs-xs color-base-60" style="margin-top: 2px; font-style: italic;">
          <% if breakdown_parts.any? %><%= breakdown_parts.join(" · ") %><% end %>
          <% if recommendation.open_to_meet_count.positive? %>
            <% if breakdown_parts.any? %> · <% end %>
            ✨ <%= t("matching.recommendations.open_to_meet_count", count: recommendation.open_to_meet_count) %>
          <% end %>
        </p>
      <% end %>
    <% end %>

    <div class="flex gap-2 mt-3" style="margin-top: 12px;">
      <%= link_to t("matching.recommendations.view_meetup"), meetup_path(meetup),
                  class: "c-btn c-btn--primary c-btn--s" %>
      <%= link_to t("matching.recommendations.declare_intent"), meetup_path(meetup),
                  class: "c-btn c-btn--secondary c-btn--s" %>
    </div>
  </div>
</div>
