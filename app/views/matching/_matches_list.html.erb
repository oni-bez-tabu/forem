<%# Matches list grouped per intent (mockup E11_Inline: screens.jsx:561-590).
    "X osób z nietabu pasuje do twojego filtra" header, then per-intent
    overline + count + grid of MatchCards with hideIntent (since the
    intent is the group). %>
<% same_intent = pool.same_intent_group %>
<% other_intent = pool.other_intent_group %>
<% total = same_intent.length + other_intent.length %>

<% if total.zero? %>
  <div class="crayons-card" style="padding: 16px; background: var(--card-secondary-bg, #f9f9f9);">
    <p class="fs-s color-base-60" style="margin: 0;"><%= t("matching.matches.empty_state") %></p>
  </div>
<% else %>
  <%# All visible declarations regrouped by intent_level for display. %>
  <% all = (same_intent + other_intent) %>
  <% by_intent = all.group_by(&:intent_level) %>

  <div class="flex items-baseline mb-3" style="justify-content: space-between;">
    <p class="fs-base" style="margin: 0;">
      <strong><%= t("matching.matches.pool_count", count: total) %></strong>
      <%= t("matching.matches.pool_count_tail") %>
    </p>
  </div>

  <% %w[open_to_meet just_vibe].each do |intent_key| %>
    <% group_decs = by_intent[intent_key] || [] %>
    <% next if group_decs.empty? %>
    <div class="mb-4">
      <div class="flex items-baseline gap-2 mb-2">
        <span class="fs-xs" style="font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--base-90, #171717);">
          <%= intent_emoji(intent_key) %>
          <%= t("matching.matches.intent_groups.#{intent_key}") %>
        </span>
        <span class="fs-xs color-base-60">— <%= group_decs.length %></span>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px;">
        <% group_decs.each do |dec| %>
          <%= render "matching/match_card", declaration: dec, meetup: meetup, hide_intent: true %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
