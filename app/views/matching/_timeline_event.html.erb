<%# Per-event card mirroring mockup E8 (screens.jsx:823-980).
    Layout: header row (kind label pill + relative time on the right), then
    meetup name/meta, then type-specific body (mini-cards for match_found,
    intent CTA for needs_intent, simple meta for declarations/rsvp/welcomes).
%>
<% kind_label = t("matching.timeline.kind_labels.#{event[:type]}", default: event[:type].to_s.humanize) %>
<% kind_color_class = case event[:type]
                     when :match_found then "color-base-90"
                     when :declaration_created, :declaration_updated then "color-accent-brand"
                     when :welcome_sent, :welcome_received then "color-accent-brand"
                     when :needs_intent then "color-accent-warning"
                     else "color-base-60"
                     end %>
<% needs_intent_style = event[:type] == :needs_intent ? "border-style: dashed; border-color: var(--accent-warning, #d97706); background: rgba(217,119,6,0.04);" : "" %>

<div class="crayons-card" style="padding: 16px; <%= needs_intent_style %>">
  <div class="flex between items-baseline gap-2 flex-wrap">
    <span class="fs-xs <%= kind_color_class %>" style="font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">
      <%= kind_label %>
    </span>
    <span class="fs-xs color-base-60"><%= time_ago_in_words(event[:at], scope: :"datetime.distance_in_words_ago") %></span>
  </div>

  <% if event[:meetup] %>
    <div class="flex between items-baseline gap-2 flex-wrap mt-1">
      <h3 class="fs-l" style="margin: 0; font-weight: 700;">
        <%= link_to event[:meetup].name, meetup_path(event[:meetup]), class: "c-link", style: "color: inherit; text-decoration: none;" %>
      </h3>
      <% case event[:type]
         when :rsvp_created, :needs_intent %>
        <span style="<%= pill_style(event[:payload][:status] == 'going' ? :success : :outline) %>">
          ✓ <%= t("matching.timeline.events.rsvp_#{event[:payload][:status]}_pill", default: event[:payload][:status]) %>
        </span>
      <% when :declaration_created, :declaration_updated %>
        <span style="<%= pill_style(:magenta) %>">
          <%= t("matching.declarations.intents.#{event[:payload][:intent]}.label") %>
        </span>
      <% end %>
    </div>
    <p class="fs-s color-base-70" style="margin: 2px 0 0;">
      📅 <%= I18n.l(event[:meetup].start_at, format: :short) %>
      <% if event[:meetup].venue_city %> · 📍 <%= event[:meetup].venue_city.name %><% end %>
    </p>
  <% end %>

  <% case event[:type]
     when :match_found %>
    <% joiners = Array(event[:payload][:joiners]) %>
    <% joiner_declarations = Array(event[:payload][:declarations]) %>
    <% if event[:payload][:count].to_i == 1 && (single_dec = joiner_declarations.first) %>
      <%# Single match — full layout per mockup E8 (screens.jsx:823-849):
          portrait 80×100 on the left, pill row + italic meetup_note,
          "Zobacz profil →" button on the right. %>
      <% jp = single_dec.matching_profile %>
      <div class="flex gap-4 items-start flex-wrap mt-3">
        <%= link_to event_scoped_profile_path(event[:meetup].slug, jp.id), class: "c-link", style: "flex: 0 0 80px; display: block;" do %>
          <% if jp.photo.present? %>
            <img src="<%= jp.photo.url %>" alt="@<%= jp.user.username %>" style="display: block; width: 80px; height: 100px; object-fit: cover; border-radius: 6px;">
          <% else %>
            <div style="width: 80px; height: 100px; background: var(--base-20, #e5e7eb); border-radius: 6px;"></div>
          <% end %>
        <% end %>
        <div class="flex-1" style="min-width: 200px;">
          <div class="flex gap-2 flex-wrap mb-2">
            <span style="<%= pill_style(:solid) %>"><%= t("matching.identity_types.#{jp.identity_type}") %></span>
            <span style="<%= pill_style(:outline) %>">📍 <%= jp.city.name %></span>
            <span style="<%= pill_style(:magenta) %>"><%= t("matching.declarations.intents.#{single_dec.intent_level}.label") %></span>
          </div>
          <% if single_dec.meetup_note.present? %>
            <p class="fs-s color-base-80" style="font-style: italic; margin: 0;">"<%= single_dec.meetup_note %>"</p>
          <% elsif jp.bio.present? %>
            <p class="fs-s color-base-70" style="margin: 0;"><%= jp.bio %></p>
          <% end %>
        </div>
        <%= link_to event_scoped_profile_path(event[:meetup].slug, jp.id), class: "c-btn c-btn--primary c-btn--s" do %>
          <%= t("matching.timeline.see_profile") %> →
        <% end %>
      </div>
    <% else %>
      <p class="fs-s color-base-70 mt-2">
        <%= t("matching.timeline.match_found_caption", count: event[:payload][:count]) %>
      </p>
      <% if joiners.any? %>
        <%# Aggregated multi-joiner grid — fixed-width tiles cap the photo
            so demo fixtures don't blow up to full card width. %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, 160px); gap: 10px; margin-top: 12px;">
          <% joiners.each do |jp| %>
            <%= link_to event_scoped_profile_path(event[:meetup].slug, jp.id), class: "c-link", style: "display: block; text-decoration: none; color: inherit;" do %>
              <div class="crayons-card" style="overflow: hidden; border: 1px solid var(--card-border, #e5e5e5);">
                <% if jp.photo.present? %>
                  <img src="<%= jp.photo.url %>" alt="@<%= jp.user.username %>" style="display: block; width: 100%; height: 140px; object-fit: cover;">
                <% else %>
                  <div style="width: 100%; height: 140px; background: var(--base-20, #e5e7eb);"></div>
                <% end %>
                <div style="padding: 8px 10px;">
                  <p class="fs-xs" style="margin: 0; font-weight: 600;">
                    <%= t("matching.identity_types.#{jp.identity_type}") %>
                  </p>
                  <p class="fs-xs color-base-60" style="margin: 2px 0 0;">📍 <%= jp.city.name %></p>
                  <% if jp.bio.present? %>
                    <p class="fs-xs color-base-70" style="margin: 4px 0 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                      <%= jp.bio %>
                    </p>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <% if event[:payload][:count].to_i > joiners.length %>
        <div class="flex justify-end mt-2">
          <%= link_to meetup_path(event[:meetup]), class: "c-btn c-btn--secondary c-btn--s" do %>
            <%= t("matching.timeline.see_all", count: event[:payload][:count]) %> →
          <% end %>
        </div>
      <% end %>
    <% end %>

  <% when :welcome_sent %>
    <p class="fs-s color-base-70 mt-1">
      💌 <%= t("matching.timeline.events.welcome_sent", username: event[:payload][:other_username]) %>
    </p>

  <% when :welcome_received %>
    <p class="fs-s color-base-70 mt-1">
      💌 <%= t("matching.timeline.events.welcome_received", username: event[:payload][:other_username]) %>
    </p>

  <% when :needs_intent %>
    <div class="flex between items-center gap-3 flex-wrap mt-2">
      <p class="fs-s color-base-70" style="margin: 0; flex: 1 1 auto; min-width: 200px;">
        <%= t("matching.timeline.needs_intent_caption") %>
      </p>
      <% if event[:meetup] %>
        <%= link_to t("matching.timeline.declare_intent_button"),
                    new_meetup_declaration_path(event[:meetup]),
                    class: "c-btn c-btn--primary c-btn--s" %>
      <% end %>
    </div>
  <% end %>
</div>
