<%# Vertical match card mirroring mockup MatchCard (components.jsx:342-365).
    Photo 1:1 with overlays (identity pill top-left, intent emoji top-right),
    then meta row (identity · city), optional intent line, bio, italic note. %>
<% profile = declaration.matching_profile %>
<% hide_intent = local_assigns.fetch(:hide_intent, false) %>

<%= link_to event_scoped_profile_path(meetup.slug, profile.id), class: "crayons-card", style: "display: block; overflow: hidden; text-decoration: none; color: inherit; padding: 0;" do %>
  <%# Photo area with overlays %>
  <div style="position: relative; width: 100%; aspect-ratio: 1 / 1; background: var(--base-20, #e5e7eb);">
    <% if profile.photo.present? %>
      <img src="<%= profile.photo.url %>" alt="@<%= profile.user.username %>" style="display: block; width: 100%; height: 100%; object-fit: cover;">
    <% end %>
    <%# Identity pill overlay top-left %>
    <span style="position: absolute; top: 10px; left: 10px; padding: 4px 10px; border-radius: 100px; font-size: 11px; font-weight: 700; background: rgba(255,255,255,0.95); color: var(--base-90, #171717); backdrop-filter: blur(4px);">
      <%= t("matching.identity_types.#{profile.identity_type}") %>
    </span>
    <%# Intent emoji glyph top-right %>
    <span title="<%= t("matching.declarations.intents.#{declaration.intent_level}.label") %>"
          style="position: absolute; top: 10px; right: 10px; width: 30px; height: 30px; border-radius: 50%; background: rgba(255,255,255,0.95); display: inline-flex; align-items: center; justify-content: center; font-size: 15px; backdrop-filter: blur(4px);">
      <%= intent_emoji(declaration.intent_level) %>
    </span>
  </div>

  <%# Body content %>
  <div style="padding: 12px 14px;">
    <div class="fs-xs" style="color: var(--base-90, #171717); font-weight: 700;">
      <%= t("matching.identity_types.#{profile.identity_type}") %>
      <span class="color-base-40" style="margin: 0 4px;">·</span>
      📍 <%= profile.city.name %>
    </div>
    <% unless hide_intent %>
      <div class="fs-xs color-base-70" style="margin-top: 4px;">
        <%= intent_emoji(declaration.intent_level) %>
        <%= t("matching.declarations.intents.#{declaration.intent_level}.label") %>
      </div>
    <% end %>
    <% if profile.bio.present? %>
      <p class="fs-xs color-base-70" style="margin: 6px 0 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
        <%= profile.bio %>
      </p>
    <% end %>
    <% if declaration.meetup_note.present? %>
      <p class="fs-xs color-base-80" style="margin: 6px 0 0; font-style: italic; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
        "<%= declaration.meetup_note %>"
      </p>
    <% end %>
  </div>
<% end %>
