<% title t("matching.onboarding.form_title") %>

<%# E6 onboarding form — Preact widget. Server renderuje shell + overline,
    Preact (#matching-profile-form-mount) renderuje cały formularz z photo
    upload / identity chips / city autocomplete / bio counter. %>
<div class="crayons-layout crayons-layout--limited-width" style="max-width: 580px;">
  <div style="margin: 20px auto 60px;">
    <div style="margin-bottom: 8px;">
      <span style="display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(var(--grey-500, 156 163 175));">
        <%= t("matching.onboarding.form_overline") %>
      </span>
    </div>
    <h1 style="font-size: 36px; font-weight: 800; line-height: 1.15; margin: 0;">
      <%= t("matching.onboarding.form_heading") %>
    </h1>
    <p style="margin: 10px 0 0; font-size: 17px; line-height: 1.5; color: rgb(var(--grey-600, 107 114 128));">
      <%= t("matching.onboarding.form_tagline") %>
    </p>

    <div id="matching-profile-form-mount"
         data-mode="create"
         data-success-url="<%= matching_onboarding_success_path %>"
         style="margin-top: 32px;">
    </div>
  </div>
</div>

<%= javascript_include_tag "matchingProfileForm", defer: true %>
