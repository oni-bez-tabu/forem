<% title t("matching.onboarding.success.title") %>

<%# E7 success screen 1:1 with hifi mockup (`screens.jsx:754`).
    Gradient circle 96px with ✓ icon → display heading → 17px body
    → primary "Przejdź do wydarzeń" + outline "Zobacz mój profil". %>
<div class="crayons-layout crayons-layout--limited-width" style="max-width: 520px;">
  <div style="margin: 80px auto; text-align: center;">
    <div style="width: 96px; height: 96px; border-radius: 50%; background: linear-gradient(135deg, var(--accent-brand, #6366f1), rgb(169,31,105)); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 48px; font-weight: 700; line-height: 1; margin-bottom: 24px; box-shadow: 0 20px 40px rgba(66,65,116,0.25);">
      ✓
    </div>
    <h1 style="font-size: 40px; font-weight: 800; line-height: 1.1; margin: 0;">
      <%= t("matching.onboarding.success.heading") %>
    </h1>
    <p style="margin: 14px 0 0; font-size: 17px; line-height: 1.5; color: rgb(var(--grey-700, 75 85 99));">
      <%= t("matching.onboarding.success.body") %>
    </p>
    <p style="margin: 10px 0 0; font-size: 14px; color: rgb(var(--grey-500, 156 163 175));">
      <%= t("matching.onboarding.success.duration") %>
    </p>

    <div class="flex" style="justify-content: center; gap: 12px; margin-top: 32px; flex-wrap: wrap;">
      <%= link_to t("matching.onboarding.success.cta_primary"),
                  meetups_path,
                  class: "c-btn c-btn--primary",
                  style: "padding: 14px 28px; font-size: 16px; font-weight: 700; min-height: 48px;" %>
      <%= link_to t("matching.onboarding.success.cta_secondary"),
                  matching_path,
                  class: "c-btn",
                  style: "padding: 14px 28px; font-size: 16px; font-weight: 600; min-height: 48px;" %>
    </div>
  </div>
</div>
