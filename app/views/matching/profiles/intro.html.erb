<% title t("matching.onboarding.intro.title") %>

<div class="crayons-layout crayons-layout--limited-width" style="max-width: 640px;">
  <div style="margin: 32px auto 80px;">
    <%# Hero icon — gradient circle with sparkle %>
    <div class="text-center mb-4">
      <div style="width: 96px; height: 96px; border-radius: 50%; background: linear-gradient(135deg, var(--accent-brand, #6366f1), rgb(169,31,105)); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 44px; margin-bottom: 24px; box-shadow: 0 20px 40px rgba(99,102,241,0.25);">
        ✨
      </div>
      <h1 class="crayons-title" style="font-size: 36px; line-height: 1.15; margin: 0 0 14px; font-weight: 800;">
        <%= t("matching.onboarding.intro.headline") %>
      </h1>
      <p class="fs-base color-base-70" style="margin: 0; font-size: 17px; line-height: 1.5;">
        <%= t("matching.onboarding.intro.tagline") %>
      </p>
    </div>

    <%# Three benefit cards %>
    <div class="flex flex-col gap-3" style="margin-top: 32px;">
      <% [
        ["🔒", "privacy"],
        ["📅", "per_event"],
        ["💬", "no_pressure"],
      ].each do |icon, key| %>
        <div class="crayons-card flex gap-4 items-start" style="padding: 18px 20px;">
          <div style="flex: 0 0 44px; width: 44px; height: 44px; border-radius: 8px; background: rgba(99,102,241,0.10); color: var(--accent-brand, #6366f1); display: inline-flex; align-items: center; justify-content: center; font-size: 20px;">
            <%= icon %>
          </div>
          <div class="flex flex-col flex-1" style="gap: 4px;">
            <div class="fs-base" style="font-weight: 700;"><%= t("matching.onboarding.intro.benefits.#{key}.title") %></div>
            <div class="fs-s color-base-70"><%= t("matching.onboarding.intro.benefits.#{key}.body") %></div>
          </div>
        </div>
      <% end %>
    </div>

    <%# Privacy info-box %>
    <div class="crayons-card flex gap-3 items-start mt-4" style="padding: 16px 20px; background: rgba(99,102,241,0.04); border-color: rgba(99,102,241,0.18);">
      <div style="flex: 0 0 24px; font-size: 16px;">🔐</div>
      <div class="fs-s color-base-80" style="line-height: 1.55;">
        <%= t("matching.onboarding.intro.privacy_html").html_safe %>
      </div>
    </div>

    <%# CTAs %>
    <div class="text-center flex flex-col items-center gap-3" style="margin-top: 36px;">
      <%= link_to t("matching.onboarding.intro.cta_primary"),
                  matching_onboarding_form_path,
                  class: "c-btn c-btn--primary c-btn--l",
                  style: "min-width: 280px; padding: 14px 28px; font-size: 16px;" %>
      <%= link_to t("matching.onboarding.intro.cta_skip"),
                  meetups_path,
                  class: "c-link fs-base color-base-60" %>
    </div>
  </div>
</div>
