<% expired = (widget_state == :expired) %>
<div class="ltag__meetup<%= ' ltag__meetup--expired' if expired %>" style="border: 1px solid var(--card-border, #ddd); border-radius: 8px; overflow: hidden; max-width: 640px; margin: 1em 0; background: var(--card-bg, #fff); <%= 'opacity: 0.65;' if expired %>">
  <% if !expired && meetup.banner.present? %>
    <a href="<%= "/wydarzenia/#{meetup.slug}" %>" style="display: block;">
      <div style="height: 140px; background: url('<%= meetup.banner.url %>') center/cover no-repeat;"></div>
    </a>
  <% elsif !expired %>
    <% gradient = MeetupsHelper::BANNER_GRADIENTS[meetup.banner_gradient] || MeetupsHelper::BANNER_GRADIENTS.fetch("dusk") %>
    <a href="<%= "/wydarzenia/#{meetup.slug}" %>" style="display: block;">
      <div style="height: 140px; background: <%= gradient %>;"></div>
    </a>
  <% else %>
    <div style="height: 80px; background: linear-gradient(135deg, #6b7280 0%, #9ca3af 100%);"></div>
  <% end %>

  <div style="padding: 16px;">
    <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--base-60, #666); margin-bottom: 4px;">
      <% if expired %>
        <%= I18n.t("meetups.widget.state.expired") %>
      <% elsif widget_state == :active %>
        <%= I18n.t("meetups.widget.state.active") %>
      <% else %>
        <%= I18n.t("meetups.widget.state.upcoming") %>
      <% end %>
    </div>

    <h3 style="margin: 0 0 8px; font-size: 18px;">
      <% if expired %>
        <span style="color: var(--base-60, #666);"><%= meetup.name %></span>
      <% else %>
        <a href="<%= "/wydarzenia/#{meetup.slug}" %>" style="color: inherit; text-decoration: none;"><%= meetup.name %></a>
      <% end %>
    </h3>

    <div style="font-size: 14px; color: var(--base-70, #555); line-height: 1.5;">
      <div>📅 <%= I18n.l(meetup.start_at, format: :short) %></div>
      <div>📍 <%= meetup.venue_name %><% if meetup.venue_city %> · <%= meetup.venue_city.name %><% end %></div>

      <% if author_rsvp_status == "going" %>
        <div style="margin-top: 6px; font-weight: 500; color: var(--accent-success, #16a34a);">
          <%= I18n.t("meetups.widget.author_rsvp.going") %>
        </div>
      <% elsif author_rsvp_status == "interested" %>
        <div style="margin-top: 6px; font-weight: 500; color: var(--accent-brand, #6366f1);">
          <%= I18n.t("meetups.widget.author_rsvp.interested") %>
        </div>
      <% end %>
    </div>

    <% unless expired %>
      <div style="margin-top: 12px;">
        <a href="<%= "/wydarzenia/#{meetup.slug}" %>" class="c-btn c-btn--secondary">
          <%= I18n.t("meetups.widget.cta") %> →
        </a>
      </div>
    <% end %>
  </div>
</div>
