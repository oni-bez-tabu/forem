<% expired = (widget_state == :expired) %>
<% organizer_label = meetup_organizer_label(meetup) %>
<% href = meetup_path(meetup) %>
<% start = meetup.start_at %>
<% day = start.day %>
<% month_short = I18n.l(start, format: "%b").upcase %>
<% gradient = expired ? "linear-gradient(135deg, #6b7280 0%, #9ca3af 100%)" : (MeetupsHelper::BANNER_GRADIENTS[meetup.banner_gradient] || MeetupsHelper::BANNER_GRADIENTS.fetch("dusk")) %>

<a href="<%= href %>" class="ltag__meetup<%= ' ltag__meetup--expired' if expired %>" style="display: grid; grid-template-columns: 72px 1fr 144px; gap: 16px; align-items: stretch; padding: 12px; border: 1px solid var(--card-border, #e5e5e5); border-radius: 8px; width: 100%; margin: 1em 0; background: var(--card-bg, #fff); text-decoration: none; color: inherit; <%= 'opacity: 0.65;' if expired %>"><%

  %><span style="display: flex; flex-direction: column; justify-content: center; align-items: center; border-right: 1px solid var(--card-border, #e5e5e5); padding-right: 12px;"><span style="font-size: 28px; font-weight: 800; line-height: 1; color: var(--base-90, #171717);"><%= day %></span><span style="font-size: 11px; font-weight: 700; letter-spacing: 0.05em; color: var(--base-60, #666); margin-top: 4px;"><%= month_short %></span><span style="font-size: 10px; color: var(--base-50, #999); margin-top: 2px;"><%= I18n.l(start, format: "%H:%M") %></span></span><%

  %><span style="display: flex; flex-direction: column; justify-content: center; gap: 4px; min-width: 0;"><span style="font-size: 15px; font-weight: 700; line-height: 1.3; color: <%= expired ? 'var(--base-60, #666)' : 'var(--base-90, #171717)' %>; overflow: hidden; text-overflow: ellipsis;"><%= meetup.name %></span><span style="font-size: 13px; color: var(--base-70, #555); line-height: 1.4;"><%= meetup.venue_name %><% if meetup.venue_city %> · <span style="color: var(--base-60, #666);"><%= meetup.venue_city.name %></span><% end %></span><span style="font-size: 12px; color: var(--base-60, #666); display: inline-flex; align-items: center; gap: 4px;">👤 <%= organizer_label %><% if expired %> · <span style="color: var(--base-50, #999); font-weight: 600;"><%= I18n.t("meetups.widget.state.expired") %></span><% end %></span></span><%

  if !expired && meetup.banner.present? %><img src="<%= meetup.banner.url %>" alt="" style="width: 144px; height: 81px; object-fit: cover; border-radius: 6px; display: block;"><%
  else %><span style="width: 144px; height: 81px; display: block; border-radius: 6px; background: <%= gradient %>;"></span><%
  end
%></a>
