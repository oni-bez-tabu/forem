<%# Share + Boost section. Copy-link button uses tiny inline JS (one-liner
    clipboard write); the boost modal is a Preact widget mounted by
    app/javascript/packs/matchingBoost.jsx. The preview HTML below is
    rendered once server-side and picked up by the modal via
    `[data-meetup-boost-preview]`. %>
<section class="crayons-card p-6">
  <h2 class="crayons-subtitle mb-3"><%= t("meetups.share.heading") %></h2>
  <div class="flex gap-2 items-center mb-3">
    <input
      type="text"
      readonly
      value="<%= meetup_url(meetup) %>"
      class="crayons-textfield flex-1"
      id="meetup-share-url-<%= meetup.id %>"
    >
    <button
      type="button"
      class="c-btn c-btn--secondary"
      data-meetup-copy-button
      data-target="#meetup-share-url-<%= meetup.id %>"
      data-copied-label="<%= t('meetups.share.copied') %>"
    >
      <%= t("meetups.share.copy_link") %>
    </button>
  </div>

  <% if user_signed_in? %>
    <button
      type="button"
      class="c-btn c-btn--primary"
      data-meetup-boost-trigger
      data-meetup-slug="<%= meetup.slug %>"
      data-no-instant
    >
      <%= t("meetups.share.share_to_nietabu") %>
    </button>
  <% end %>
</section>

<%# Hidden preview HTML for the Preact boost modal. %>
<% if user_signed_in? %>
  <div data-meetup-boost-preview="<%= meetup.slug %>" hidden>
    <%= render "meetups/liquid", meetup: meetup, widget_state: :upcoming %>
  </div>
<% end %>

<script>
  (function() {
    document.querySelectorAll("[data-meetup-copy-button]").forEach(function(btn) {
      btn.addEventListener("click", function() {
        var input = document.querySelector(btn.dataset.target);
        if (!input) return;
        input.select();
        try { navigator.clipboard.writeText(input.value); }
        catch (_) { document.execCommand("copy"); }
        var original = btn.textContent;
        btn.textContent = btn.dataset.copiedLabel;
        setTimeout(function() { btn.textContent = original; }, 1500);
      });
    });
  })();
</script>
