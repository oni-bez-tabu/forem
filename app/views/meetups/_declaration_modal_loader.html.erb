<%# Loader for the E10 declaration modal — included on pages that want to
    open the popup without a page reload (e.g. /matching dashboard,
    /meetups/:slug). Provides:
    - #matching-modal-host — where fetched modal markup is injected
    - Global JS with event delegation: opens modal via fetch when any
      [data-declaration-modal-trigger] link is clicked, and handles
      close/intent-toggle/note-counter for both server-rendered and
      injected instances. %>
<div id="matching-modal-host"></div>

<script>
  (function() {
    if (window.__declarationModalLoaderInit) return;
    window.__declarationModalLoaderInit = true;

    var NOTE_MAX = <%= MeetupMatchingDeclaration::NOTE_MAX_LENGTH %>;
    var SELECTED_BG = "rgba(99,102,241,0.06)";
    var BRAND_BORDER = "var(--accent-brand, #6366f1)";
    var BASE_BORDER = "var(--card-border, #e5e5e5)";

    function getBackdrop() {
      return document.getElementById("declaration-modal-backdrop");
    }

    function clearQuery() {
      try {
        var url = new URL(window.location.href);
        if (!url.searchParams.has("declare")) return;
        url.searchParams.delete("declare");
        var qs = url.searchParams.toString();
        window.history.replaceState({}, "", url.pathname + (qs ? "?" + qs : "") + url.hash);
      } catch (_e) { /* no-op */ }
    }

    function closeModal() {
      var backdrop = getBackdrop();
      if (!backdrop) return;
      backdrop.remove();
      clearQuery();
      document.removeEventListener("keydown", onKeydown);
    }

    // Lightweight toast for success/error feedback after AJAX submit.
    function showToast(message, variant) {
      var existing = document.getElementById("matching-toast");
      if (existing) existing.remove();
      var bg = variant === "error"
        ? "rgb(220,38,38)"
        : "rgb(5,150,105)";
      var toast = document.createElement("div");
      toast.id = "matching-toast";
      toast.textContent = message;
      toast.style.cssText = [
        "position: fixed",
        "left: 50%",
        "top: 24px",
        "transform: translateX(-50%)",
        "background: " + bg,
        "color: #fff",
        "padding: 12px 20px",
        "border-radius: 999px",
        "font-size: 14px",
        "font-weight: 600",
        "box-shadow: 0 10px 30px rgba(0,0,0,0.18)",
        "z-index: 2000",
        "opacity: 0",
        "transition: opacity 180ms ease",
      ].join("; ");
      document.body.appendChild(toast);
      window.requestAnimationFrame(function() { toast.style.opacity = "1"; });
      setTimeout(function() {
        toast.style.opacity = "0";
        setTimeout(function() { toast.remove(); }, 220);
      }, 2400);
    }

    function csrfToken() {
      var meta = document.querySelector('meta[name="csrf-token"]');
      return meta ? meta.getAttribute("content") : null;
    }

    // SPA-style: after the modal saves, fetch the current page and swap the
    // [data-soft-refresh-root] container's HTML. Preserves scroll position
    // and the modal host. If the container can't be found in either DOM
    // (e.g. the page changed away while we were saving) — silently no-op.
    function softRefreshCurrentPage() {
      var currentRoot = document.querySelector("[data-soft-refresh-root]");
      if (!currentRoot) return Promise.resolve();
      return fetch(window.location.href, {
        credentials: "same-origin",
        headers: { "X-Requested-With": "XMLHttpRequest", "Accept": "text/html" },
      })
      .then(function(resp) { return resp.ok ? resp.text() : null; })
      .then(function(html) {
        if (!html) return;
        var doc = new DOMParser().parseFromString(html, "text/html");
        var newRoot = doc.querySelector("[data-soft-refresh-root]");
        if (!newRoot) return;
        var stillThere = document.querySelector("[data-soft-refresh-root]");
        if (stillThere) stillThere.innerHTML = newRoot.innerHTML;
      })
      .catch(function() { /* network error — keep stale UI, toast already shown */ });
    }

    function submitModalForm(form) {
      var backdrop = getBackdrop();
      var data = new FormData(form);
      var submitBtn = form.querySelector('input[type="submit"], button[type="submit"]');
      var submitOrig = submitBtn ? submitBtn.value || submitBtn.textContent : null;
      if (submitBtn) {
        submitBtn.disabled = true;
        if ("value" in submitBtn) submitBtn.value = "…";
      }

      fetch(form.action, {
        method: "POST", // _method=patch hidden field handles update routing
        body: data,
        credentials: "same-origin",
        headers: {
          "Accept": "application/json",
          "X-Requested-With": "XMLHttpRequest",
          "X-CSRF-Token": csrfToken() || "",
        },
      })
      .then(function(resp) {
        return resp.json().then(function(json) { return { ok: resp.ok, json: json }; });
      })
      .then(function(result) {
        if (submitBtn) {
          submitBtn.disabled = false;
          if (submitOrig != null) {
            if ("value" in submitBtn) submitBtn.value = submitOrig;
            else submitBtn.textContent = submitOrig;
          }
        }
        if (result.ok) {
          closeModal();
          showToast(result.json.flash || "OK", "success");
          softRefreshCurrentPage();
        } else {
          var errors = (result.json && result.json.errors) || ["Wystąpił błąd"];
          renderModalErrors(backdrop, errors);
        }
      })
      .catch(function() {
        if (submitBtn) {
          submitBtn.disabled = false;
          if (submitOrig != null) {
            if ("value" in submitBtn) submitBtn.value = submitOrig;
            else submitBtn.textContent = submitOrig;
          }
        }
        showToast("Błąd sieci", "error");
      });
    }

    function renderModalErrors(backdrop, errors) {
      if (!backdrop) return;
      var existing = backdrop.querySelector(".js-declaration-modal-errors");
      if (existing) existing.remove();
      var box = document.createElement("div");
      box.className = "js-declaration-modal-errors crayons-notice crayons-notice--danger";
      box.style.cssText = "padding: 12px 16px; margin: 0 28px 16px;";
      box.setAttribute("role", "alert");
      var ul = document.createElement("ul");
      ul.style.cssText = "margin: 0; padding-left: 18px;";
      errors.forEach(function(msg) {
        var li = document.createElement("li");
        li.textContent = msg;
        ul.appendChild(li);
      });
      box.appendChild(ul);
      var form = backdrop.querySelector("form");
      if (form) form.parentNode.insertBefore(box, form);
    }

    function onKeydown(e) {
      if (e.key === "Escape") {
        e.preventDefault();
        closeModal();
      }
    }

    function repaintIntentCards(backdrop) {
      var cards = backdrop.querySelectorAll(".js-intent-card");
      cards.forEach(function(card) {
        var radio = card.querySelector(".js-intent-radio");
        var sel = radio && radio.checked;
        card.style.borderColor = sel ? BRAND_BORDER : BASE_BORDER;
        card.style.background = sel ? SELECTED_BG : "transparent";
      });
    }

    function wireModal(backdrop) {
      // Backdrop click closes
      backdrop.addEventListener("mousedown", function(e) {
        if (e.target === backdrop) closeModal();
      });
      document.addEventListener("keydown", onKeydown);

      // Intent cards: repaint on radio change
      var radios = backdrop.querySelectorAll(".js-intent-radio");
      radios.forEach(function(radio) {
        radio.addEventListener("change", function() { repaintIntentCards(backdrop); });
      });
      // Whole-card click selects the radio
      backdrop.querySelectorAll(".js-intent-card").forEach(function(card) {
        card.addEventListener("click", function() {
          var radio = card.querySelector(".js-intent-radio");
          if (radio && !radio.checked) {
            radio.checked = true;
            radio.dispatchEvent(new Event("change", { bubbles: true }));
          }
        });
      });
      repaintIntentCards(backdrop);

      // Note counter
      var note = backdrop.querySelector(".js-meetup-note-input");
      var counter = backdrop.querySelector(".js-meetup-note-counter");
      if (note && counter) {
        note.addEventListener("input", function() {
          counter.textContent = note.value.length + "/" + NOTE_MAX;
        });
      }
    }

    function showModal() {
      var backdrop = getBackdrop();
      if (!backdrop) return;
      backdrop.style.display = "flex";
      wireModal(backdrop);
    }

    function openFromFetch(slug) {
      // If a modal is already open, close it first.
      var existing = getBackdrop();
      if (existing) existing.remove();

      fetch("/meetups/" + encodeURIComponent(slug) + "/declaration/modal", {
        credentials: "same-origin",
        headers: { "Accept": "text/html", "X-Requested-With": "XMLHttpRequest" }
      })
      .then(function(resp) {
        if (!resp.ok) {
          // Fallback: server didn't allow modal (no profile / no RSVP / etc.).
          // Fall back to the standard ?declare=1 page so the user sees a
          // meaningful error or the canonical hub state.
          window.location.href = "/meetups/" + encodeURIComponent(slug) + "?declare=1";
          return null;
        }
        return resp.text();
      })
      .then(function(html) {
        if (!html) return;
        var host = document.getElementById("matching-modal-host");
        if (!host) {
          host = document.createElement("div");
          host.id = "matching-modal-host";
          document.body.appendChild(host);
        }
        host.innerHTML = html;
        showModal();
      })
      .catch(function() {
        window.location.href = "/meetups/" + encodeURIComponent(slug) + "?declare=1";
      });
    }

    // Click delegation: intercept any link/button asking to open the modal.
    document.addEventListener("click", function(e) {
      var trigger = e.target.closest("[data-declaration-modal-trigger]");
      if (trigger) {
        e.preventDefault();
        var slug = trigger.dataset.meetupSlug;
        if (slug) openFromFetch(slug);
        return;
      }
      // Close link inside an injected modal
      var closeLink = e.target.closest(".js-declaration-modal-close");
      if (closeLink) {
        e.preventDefault();
        closeModal();
      }
    });

    // Form submit delegation: AJAX the declaration modal's form so the
    // page never reloads. Server returns JSON; on success modal closes
    // and a toast confirms.
    document.addEventListener("submit", function(e) {
      var form = e.target;
      if (!form || form.nodeName !== "FORM") return;
      var backdrop = getBackdrop();
      if (!backdrop || !backdrop.contains(form)) return;
      e.preventDefault();
      submitModalForm(form);
    });

    // If the page was server-rendered with an open modal (?declare=1), wire
    // it up on DOM-ready so close/intent/counter all work.
    function wireServerRendered() {
      var backdrop = getBackdrop();
      if (backdrop) wireModal(backdrop);
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", wireServerRendered);
    } else {
      wireServerRendered();
    }
  })();
</script>
