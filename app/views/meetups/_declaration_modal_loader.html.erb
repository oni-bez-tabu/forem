<%# Loader for the E10 declaration modal — included on pages that want to
    open the popup without a page reload (e.g. /matching dashboard,
    /meetups/:slug). Provides:
    - #matching-modal-host — where fetched modal markup is injected
    - Global JS with event delegation: opens modal via fetch when any
      [data-declaration-modal-trigger] link is clicked, and handles
      close/intent-toggle/note-counter for both server-rendered and
      injected instances. %>
<div id="matching-modal-host"></div>

<script>
  (function() {
    if (window.__declarationModalLoaderInit) return;
    window.__declarationModalLoaderInit = true;

    var NOTE_MAX = <%= MeetupMatchingDeclaration::NOTE_MAX_LENGTH %>;
    var SCROLL_KEY = "matchingDeclarationScroll";

    // Restore scroll across the full-page reload that happens after
    // submitting the modal (POST → server redirect). We persist
    // {pathname, y} in sessionStorage on submit and restore on load
    // only when the user lands on the same path they started from.
    try {
      var stash = sessionStorage.getItem(SCROLL_KEY);
      if (stash) {
        sessionStorage.removeItem(SCROLL_KEY);
        var parsed = JSON.parse(stash);
        if (parsed && parsed.path === window.location.pathname) {
          window.requestAnimationFrame(function() {
            window.scrollTo(0, parsed.y || 0);
          });
        }
      }
    } catch (_e) { /* no-op */ }

    document.addEventListener("submit", function(e) {
      var form = e.target;
      if (!form || form.nodeName !== "FORM") return;
      var backdrop = getBackdrop();
      if (!backdrop || !backdrop.contains(form)) return;
      try {
        sessionStorage.setItem(SCROLL_KEY, JSON.stringify({
          y: window.scrollY || window.pageYOffset || 0,
          path: window.location.pathname,
        }));
      } catch (_e) { /* no-op */ }
    });
    var SELECTED_BG = "rgba(99,102,241,0.06)";
    var BRAND_BORDER = "var(--accent-brand, #6366f1)";
    var BASE_BORDER = "var(--card-border, #e5e5e5)";

    function getBackdrop() {
      return document.getElementById("declaration-modal-backdrop");
    }

    function clearQuery() {
      try {
        var url = new URL(window.location.href);
        if (!url.searchParams.has("declare")) return;
        url.searchParams.delete("declare");
        var qs = url.searchParams.toString();
        window.history.replaceState({}, "", url.pathname + (qs ? "?" + qs : "") + url.hash);
      } catch (_e) { /* no-op */ }
    }

    function closeModal() {
      var backdrop = getBackdrop();
      if (!backdrop) return;
      backdrop.remove();
      clearQuery();
      document.removeEventListener("keydown", onKeydown);
    }

    function onKeydown(e) {
      if (e.key === "Escape") {
        e.preventDefault();
        closeModal();
      }
    }

    function repaintIntentCards(backdrop) {
      var cards = backdrop.querySelectorAll(".js-intent-card");
      cards.forEach(function(card) {
        var radio = card.querySelector(".js-intent-radio");
        var sel = radio && radio.checked;
        card.style.borderColor = sel ? BRAND_BORDER : BASE_BORDER;
        card.style.background = sel ? SELECTED_BG : "transparent";
      });
    }

    function wireModal(backdrop) {
      // Backdrop click closes
      backdrop.addEventListener("mousedown", function(e) {
        if (e.target === backdrop) closeModal();
      });
      document.addEventListener("keydown", onKeydown);

      // Intent cards: repaint on radio change
      var radios = backdrop.querySelectorAll(".js-intent-radio");
      radios.forEach(function(radio) {
        radio.addEventListener("change", function() { repaintIntentCards(backdrop); });
      });
      // Whole-card click selects the radio
      backdrop.querySelectorAll(".js-intent-card").forEach(function(card) {
        card.addEventListener("click", function() {
          var radio = card.querySelector(".js-intent-radio");
          if (radio && !radio.checked) {
            radio.checked = true;
            radio.dispatchEvent(new Event("change", { bubbles: true }));
          }
        });
      });
      repaintIntentCards(backdrop);

      // Note counter
      var note = backdrop.querySelector(".js-meetup-note-input");
      var counter = backdrop.querySelector(".js-meetup-note-counter");
      if (note && counter) {
        note.addEventListener("input", function() {
          counter.textContent = note.value.length + "/" + NOTE_MAX;
        });
      }
    }

    function showModal() {
      var backdrop = getBackdrop();
      if (!backdrop) return;
      backdrop.style.display = "flex";
      wireModal(backdrop);
    }

    function openFromFetch(slug) {
      // If a modal is already open, close it first.
      var existing = getBackdrop();
      if (existing) existing.remove();

      fetch("/meetups/" + encodeURIComponent(slug) + "/declaration/modal", {
        credentials: "same-origin",
        headers: { "Accept": "text/html", "X-Requested-With": "XMLHttpRequest" }
      })
      .then(function(resp) {
        if (!resp.ok) {
          // Fallback: server didn't allow modal (no profile / no RSVP / etc.).
          // Fall back to the standard ?declare=1 page so the user sees a
          // meaningful error or the canonical hub state.
          window.location.href = "/meetups/" + encodeURIComponent(slug) + "?declare=1";
          return null;
        }
        return resp.text();
      })
      .then(function(html) {
        if (!html) return;
        var host = document.getElementById("matching-modal-host");
        if (!host) {
          host = document.createElement("div");
          host.id = "matching-modal-host";
          document.body.appendChild(host);
        }
        host.innerHTML = html;
        showModal();
      })
      .catch(function() {
        window.location.href = "/meetups/" + encodeURIComponent(slug) + "?declare=1";
      });
    }

    // Click delegation: intercept any link/button asking to open the modal.
    document.addEventListener("click", function(e) {
      var trigger = e.target.closest("[data-declaration-modal-trigger]");
      if (trigger) {
        e.preventDefault();
        var slug = trigger.dataset.meetupSlug;
        if (slug) openFromFetch(slug);
        return;
      }
      // Close link inside an injected modal
      var closeLink = e.target.closest(".js-declaration-modal-close");
      if (closeLink) {
        e.preventDefault();
        closeModal();
      }
    });

    // If the page was server-rendered with an open modal (?declare=1), wire
    // it up on DOM-ready so close/intent/counter all work.
    function wireServerRendered() {
      var backdrop = getBackdrop();
      if (backdrop) wireModal(backdrop);
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", wireServerRendered);
    } else {
      wireServerRendered();
    }
  })();
</script>
