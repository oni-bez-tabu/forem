<section>
  <div class="flex items-baseline flex-wrap mb-3" style="justify-content: space-between;">
    <h2 class="crayons-subtitle-1" style="margin: 0;"><%= t("meetups.show.rsvp_heading") %></h2>
    <span class="fs-xs color-base-60"><%= t("meetups.show.counts_caveat") %></span>
  </div>

  <% if user_signed_in? %>
    <div class="flex gap-3 items-center flex-wrap">
      <%= button_to meetup_rsvp_path(meetup, status: "going"),
                    method: :post,
                    form: { class: "inline" },
                    class: "c-btn c-btn--l #{current_rsvp&.status == 'going' ? 'c-btn--primary' : 'c-btn--secondary'}" do %>
        <%= current_rsvp&.status == "going" ? "✓ #{t('meetups.rsvp.going')}" : t("meetups.rsvp.going") %>
      <% end %>
      <%= button_to meetup_rsvp_path(meetup, status: "interested"),
                    method: :post,
                    form: { class: "inline" },
                    class: "c-btn c-btn--l #{current_rsvp&.status == 'interested' ? 'c-btn--primary' : 'c-btn--secondary'}" do %>
        <%= current_rsvp&.status == "interested" ? "✓ #{t('meetups.rsvp.interested')}" : t("meetups.rsvp.interested") %>
      <% end %>
      <div class="flex flex-col" style="margin-left: auto; align-items: flex-end;">
        <div class="fs-base">
          <strong><%= t("meetups.show.going_from_nietabu", count: meetup.going_count) %></strong>
          <%= t("meetups.show.going_verb") %>
          <span class="color-base-40" style="margin: 0 6px;">·</span>
          <strong><%= meetup.interested_count %></strong>
          <%= t("meetups.show.interested_short") %>
        </div>
        <div class="fs-xs color-base-60" style="margin-top: 2px;">
          <%= t("meetups.show.other_channels_hint") %>
        </div>
      </div>
    </div>

    <% if current_rsvp&.status == "going" %>
      <div class="crayons-card flex items-center gap-3 mt-3" style="padding: 12px 16px; background: rgba(5,150,105,0.08); border-color: rgba(5,150,105,0.25);">
        <span style="font-size: 18px; color: rgb(5,150,105);">✓</span>
        <div class="fs-s">
          <strong><%= t("meetups.show.going_confirmation") %></strong>
          <span class="color-base-60"><%= t("meetups.show.going_confirmation_tail") %></span>
        </div>
      </div>
    <% end %>
  <% else %>
    <p><%= link_to t("meetups.rsvp.sign_in_required"), new_user_session_path, class: "c-link" %></p>
  <% end %>
</section>
