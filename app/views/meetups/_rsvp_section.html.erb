<%# RSVP widget — mounted by app/javascript/packs/matchingRsvp.jsx.
    Server renders the data attrs only; Preact owns the markup inside. %>
<section>
  <div data-rsvp-mount
       data-slug="<%= meetup.slug %>"
       data-current-status="<%= current_rsvp&.status %>"
       data-going-count="<%= meetup.going_count %>"
       data-interested-count="<%= meetup.interested_count %>"
       data-signed-in="<%= user_signed_in? %>"
       data-sign-in-url="<%= new_user_session_path %>">
  </div>
</section>
