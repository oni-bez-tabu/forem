<%# E10 declaration popup — 1:1 with hifi mockup IntentPopup (`screens.jsx:405`).
    Triggered by `?declare=1` on the meetup hub. Cancel + backdrop click drop
    the query; Save submits the standard declaration form. %>
<% modal_open = local_assigns.fetch(:open, false) %>
<% declaration = local_assigns.fetch(:declaration) %>
<% meetup = local_assigns.fetch(:meetup) %>
<% intents = MeetupMatchingDeclaration::INTENT_LEVELS %>

<div id="declaration-modal-backdrop"
     class="js-declaration-modal-backdrop"
     data-meetup-slug="<%= meetup.slug %>"
     style="position: fixed; inset: 0; background: rgba(0,0,0,0.55); display: <%= modal_open ? 'flex' : 'none' %>; align-items: center; justify-content: center; z-index: 1000; padding: 24px;">
  <div class="js-declaration-modal-card"
       style="background: var(--card-bg, #fff); border-radius: 16px; max-width: 560px; width: 100%; max-height: calc(100vh - 48px); overflow-y: auto; box-shadow: 0 24px 48px rgba(0,0,0,0.25);">

    <%# Header %>
    <div class="flex items-start" style="padding: 24px 28px 12px; gap: 16px; justify-content: space-between;">
      <div style="flex: 1 1 auto;">
        <h2 style="font-size: 22px; font-weight: 800; margin: 0; line-height: 1.2;">
          <%= t("matching.declarations.modal.title") %>
        </h2>
        <p style="margin: 6px 0 0; font-size: 13px; color: rgb(var(--grey-600, 107 114 128));">
          <%= t("matching.declarations.modal.context") %>
          <strong style="color: rgb(var(--grey-900, 17 24 39));"><%= meetup.name %></strong>
        </p>
      </div>
      <%= link_to "✕", meetup_path(meetup),
                  class: "js-declaration-modal-close",
                  style: "font-size: 18px; line-height: 1; padding: 8px 10px; background: transparent; border: 0; color: rgb(var(--grey-600, 107 114 128)); text-decoration: none; border-radius: 6px;",
                  aria: { label: t("matching.declarations.cancel") } %>
    </div>

    <%= form_with model: declaration,
                  url: meetup_declaration_path(meetup.slug),
                  method: declaration.persisted? ? :patch : :post,
                  local: true do |form| %>
      <div style="padding: 12px 28px 0;">
        <% if declaration.errors.any? %>
          <div class="crayons-notice crayons-notice--danger" role="alert" style="padding: 12px 16px; margin-bottom: 16px;">
            <ul style="margin: 0; padding-left: 18px;">
              <% declaration.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <p style="margin: 0 0 20px; font-size: 14px; line-height: 1.55; color: rgb(var(--grey-600, 107 114 128));">
          <%= t("matching.declarations.modal.body") %>
        </p>

        <%# Intent radio cards %>
        <fieldset style="border: 0; padding: 0; margin: 0 0 20px;">
          <legend style="font-size: 13px; font-weight: 700; margin-bottom: 10px;">
            <%= t("matching.declarations.modal.intent_label") %>
          </legend>
          <div class="flex flex-col" style="gap: 10px;">
            <% intents.each do |level| %>
              <% selected = declaration.intent_level == level %>
              <label class="js-intent-card"
                     data-value="<%= level %>"
                     style="display: flex; align-items: flex-start; gap: 12px; padding: 14px 16px; border-radius: 12px; cursor: pointer; border: 1px solid <%= selected ? 'var(--accent-brand, #6366f1)' : 'var(--card-border, #e5e5e5)' %>; background: <%= selected ? 'rgba(99,102,241,0.06)' : 'transparent' %>; transition: all 120ms ease;">
                <%= form.radio_button :intent_level, level,
                                      class: "js-intent-radio",
                                      style: "margin: 6px 0 0; accent-color: var(--accent-brand, #6366f1);" %>
                <div style="font-size: 24px; line-height: 1; flex: 0 0 28px; padding-top: 2px;">
                  <%= intent_emoji(level) %>
                </div>
                <div style="flex: 1 1 auto; min-width: 0;">
                  <div style="font-size: 15px; font-weight: 700; line-height: 1.3;">
                    <%= t("matching.declarations.intents.#{level}.label") %>
                  </div>
                  <div style="font-size: 13px; line-height: 1.45; color: rgb(var(--grey-700, 75 85 99)); margin-top: 4px;">
                    <%= t("matching.declarations.intents.#{level}.help") %>
                  </div>
                </div>
              </label>
            <% end %>
          </div>
        </fieldset>

        <%# Meetup note %>
        <div class="js-meetup-note-group flex flex-col" style="gap: 8px; margin-bottom: 20px;">
          <%= form.label :meetup_note, t("matching.declarations.fields.meetup_note"),
                          style: "font-size: 13px; font-weight: 700;" %>
          <%= form.text_area :meetup_note,
                              maxlength: MeetupMatchingDeclaration::NOTE_MAX_LENGTH,
                              rows: 3,
                              class: "crayons-textfield js-meetup-note-input",
                              placeholder: t("matching.declarations.modal.note_placeholder") %>
          <div class="flex" style="justify-content: space-between; gap: 12px; flex-wrap: wrap;">
            <span style="font-size: 12px; color: rgb(var(--grey-600, 107 114 128));">
              <%= t("matching.declarations.modal.note_helper") %>
            </span>
            <span class="js-meetup-note-counter" style="font-size: 12px; color: rgb(var(--grey-600, 107 114 128)); font-variant-numeric: tabular-nums;">
              <%= declaration.meetup_note.to_s.length %>/<%= MeetupMatchingDeclaration::NOTE_MAX_LENGTH %>
            </span>
          </div>
        </div>
      </div>

      <%# Footer %>
      <div class="flex" style="padding: 16px 28px 24px; gap: 12px; justify-content: flex-end; border-top: 1px solid var(--card-border, #e5e5e5); flex-wrap: wrap;">
        <%= link_to t("matching.declarations.cancel"), meetup_path(meetup),
                    class: "c-btn js-declaration-modal-close",
                    style: "padding: 10px 20px; font-size: 14px; font-weight: 600;" %>
        <%= form.submit t("matching.declarations.modal.save"),
                        class: "c-btn c-btn--primary",
                        style: "padding: 10px 22px; font-size: 14px; font-weight: 700;" %>
      </div>
    <% end %>
  </div>
</div>

<%# All interactivity (open/close/intent toggle/counter) lives in
    meetups/_declaration_modal_loader so the same handlers work when the
    modal is rendered server-side AND when it's injected via fetch. %>
