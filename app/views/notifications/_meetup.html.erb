<%# Matching POC custom notifications. Notifiable is a Meetup; action
    differentiates the trigger. Other notification partials in this folder
    are owned by Forem core; adding this one extends the bell dropdown so
    matching-related events don't crash render_each_notification_or_error. %>
<% json_data = notification.json_data || {} %>
<% meetup_data = json_data["meetup"] || {} %>
<% meetup_path = meetup_data["slug"].present? ? "/meetups/#{meetup_data['slug']}" : "#" %>

<div class="crayons-card notification">
  <div class="notification__content p-4">
    <% if notification.action == "matching_pool_member" %>
      <% new_profile = json_data["new_profile"] || {} %>
      <header class="mb-2">
        <h2 class="fs-base fw-normal">
          ✨ <%= t("views.notifications.matching.new_pool_member_html",
                   meetup: link_to(meetup_data["name"].to_s, meetup_path, class: "crayons-link fw-bold")) %>
        </h2>
        <% if new_profile["username"].present? %>
          <p class="fs-s color-base-60 mt-1">@<%= new_profile["username"] %></p>
        <% end %>
      </header>

    <% elsif notification.action == "new_city_meetup" %>
      <header class="mb-2">
        <h2 class="fs-base fw-normal">
          📅 <%= t("views.notifications.matching.new_city_meetup_html",
                   meetup: link_to(meetup_data["name"].to_s, meetup_path, class: "crayons-link fw-bold")) %>
        </h2>
        <% if meetup_data["city"].present? %>
          <p class="fs-s color-base-60 mt-1">📍 <%= meetup_data["city"] %></p>
        <% end %>
      </header>

    <% else %>
      <header><h2 class="fs-base"><%= meetup_data["name"] %></h2></header>
    <% end %>

    <p class="lh-tight">
      <small class="fs-s color-base-60">
        <%= time_ago_in_words(notification.notified_at || notification.created_at) %>
        <%= t("matching.timeline.ago") %>
      </small>
    </p>
  </div>
</div>
