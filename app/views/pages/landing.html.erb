<%#
  Tresc list (posty, profile, tematy) pochodzi ze strony Page o slugu "landing-data"
  z szablonem json - edytowalnej z admina, bez deployu. Plik w config/ jest awaryjnym
  kompletem, uzywanym dopoki ta strona nie istnieje.
%>
<%
  landing_data = Page.find_by(slug: "landing-data")&.body_json
  landing_data = JSON.parse(Rails.root.join("config/landing_data.json").read) unless landing_data.is_a?(Hash)
  landing_posts    = Array(landing_data["posts"])
  landing_profiles = Array(landing_data["profiles"])
  landing_topics   = Array(landing_data["topics"])
  app_store_url    = "https://apps.apple.com/pl/app/nie-tabu/id6756076077"
  google_play_url  = ENV["GOOGLE_PLAY_URL"].presence
%>
<svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden"><defs><symbol id="icon-ArrowRight" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></symbol><symbol id="icon-ArrowLeft" viewBox="0 0 24 24"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></symbol><symbol id="icon-ArrowUp" viewBox="0 0 24 24"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></symbol><symbol id="icon-ArrowUpRight" viewBox="0 0 24 24"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></symbol><symbol id="icon-ArrowDown" viewBox="0 0 24 24"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></symbol><symbol id="icon-Play" viewBox="0 0 24 24"><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"/></symbol><symbol id="icon-Heart" viewBox="0 0 24 24"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/></symbol><symbol id="icon-MessageCircle" viewBox="0 0 24 24"><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/></symbol><symbol id="icon-Bookmark" viewBox="0 0 24 24"><path d="M17 3a2 2 0 0 1 2 2v15a1 1 0 0 1-1.496.868l-4.512-2.578a2 2 0 0 0-1.984 0l-4.512 2.578A1 1 0 0 1 5 20V5a2 2 0 0 1 2-2z"/></symbol><symbol id="icon-BookOpen" viewBox="0 0 24 24"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></symbol></defs></svg><section class="hero" aria-label="Miejsce dla społeczności"><nav class="hero-nav"><picture><source srcset="<%= image_path("landing/logo.webp") %>" type="image/webp"><img class="brand" src="<%= image_path("landing/logo.png") %>" alt="nietabu" fetchpriority="high" decoding="async"></picture><div><a class="plain" href="<%= sign_up_path %>">Zaloguj się</a><a class="primary small" href="<%= sign_up_path(state: "new-user") %>">Dołącz do nas</a></div></nav><div class="hero-layout"><div class="hero-copy"><h1>Miejsce dla<br>społeczności.<span>#żyjebeztabu</span></h1><p>Jedyna taka przestrzeń w Polsce. Miejsce do rozmowy i poznawania ludzi bez wstydu i oceniania.</p><div class="hero-actions"><a class="primary" href="<%= sign_up_path(state: "new-user") %>">Dołącz do nas <span aria-hidden="true"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#icon-ArrowRight"></use></svg></span></a><a class="secondary" href="<%= sign_up_path %>">Zaloguj się</a></div><div class="apps"><p>Pobierz aplikację</p><div><a class="store-badge" href="<%= app_store_url %>" rel="noopener"><span class="store-crop apple-crop" aria-hidden="true"></span><span class="sr-only">Pobierz z App Store</span></a><% if google_play_url.present? %><a class="store-badge" href="<%= google_play_url %>" rel="noopener"><span class="store-crop google-crop" aria-hidden="true"></span><span class="sr-only">Pobierz z Google Play</span></a><% end %></div></div></div><div class="hero-art layers" aria-label="Społeczność nietabu"><div class="layer-light"></div><div class="layer layer-toby" data-depth="18"><div class="float-toby"><picture><source srcset="<%= image_path("landing/toby-hero.webp") %>" type="image/webp"><img class="isolated-toby" src="<%= image_path("landing/toby-hero.jpg") %>" alt="Toby wskazuje w stronę zaproszenia do społeczności" fetchpriority="high" decoding="async"></picture></div></div><div class="layer layer-live" data-depth="-10"><div class="floating live-card"><div class="live-tag"><i></i> POKÓJ LIVE</div><h3>Jak otworzyć swój związek?</h3><p>Otwieram pokój i czekam na Wasze rady</p><div class="room-bottom"><div class="room-people"><span class="portrait portrait-marta" aria-hidden="true"></span><span class="portrait portrait-man" aria-hidden="true"></span><span class="portrait portrait-woman" aria-hidden="true"></span></div><div class="sound-bars" aria-hidden="true"><b></b><b></b><b></b><b></b><b></b><b></b><b></b><b></b><b></b><b></b><b></b><b></b><b></b></div></div><span class="live-pill">Rozmowa trwa</span></div></div><div class="layer layer-post" data-depth="10"><div class="floating post-card"><div class="post-author"><span class="portrait portrait-marta" aria-hidden="true"></span><div><strong>Marta</strong><small>Rozmowy bez tabu</small></div><span class="post-time">3 godz. temu ···</span></div><h3>Swing klub w Warszawie<br>co polecacie?</h3><p>Planujemy wybrać się w ten weekend.<br>Gdzie warto pójść?<br>Chętnie poznamy Wasze doświadczenia!</p><div class="post-reactions"><span><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#icon-Heart"></use></svg> <small>125</small></span><span><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#icon-MessageCircle"></use></svg> <small>34</small></span><span class="save-icon"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#icon-Bookmark"></use></svg></span></div></div></div><div class="layer layer-coin" data-depth="24"><div class="floating coin-card"><span class="gold-coin"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#icon-Heart"></use></svg></span><span><small>Educoiny</small><strong>120</strong></span></div></div><div class="layer layer-knowledge" data-depth="-16"><div class="floating knowledge-card"><span class="knowledge-label"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#icon-BookOpen"></use></svg> WIEDZA</span><div><h3>Twoje granice<br>mają znaczenie</h3><p>Artykuły, poradniki, wywiady<br>i historie z życia.</p></div><div class="article-art" aria-hidden="true"></div><span class="round-arrow"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#icon-ArrowUpRight"></use></svg></span></div></div><div class="layer layer-avatar" data-depth="28"><div class="floating floating-avatar"><span class="portrait portrait-man" aria-hidden="true"></span><i></i></div></div><span class="scribble note-top" style="position:absolute;left:3%;top:0;right:auto;bottom:auto">jest tu miejsce<br>dla Ciebie ♡</span><span class="scribble note-bottom" style="position:absolute;left:auto;right:3%;top:96%;bottom:auto">mniej wstydu<br>więcej nas ♡</span><span class="scribble note-people" style="position:absolute;left:31%;top:84%;right:auto;bottom:auto">prawdziwi<br>ludzie ♡</span><span class="scribble note-knowledge" style="position:absolute;left:auto;right:-1%;top:51%;bottom:auto">wiedza<br>to też<br>wolność ♡</span><svg class="hero-drawn-arrows" viewBox="0 0 790 750" fill="none" aria-hidden="true" focusable="false"><g class="drawn-arrow" stroke="#dba0f1"><path pathLength="1" d="M123 91 C100 110 68 111 35 98"/><path pathLength="1" d="M46 94 L35 98 L43 108"/></g><g class="drawn-arrow" stroke="#dba0f1"><path pathLength="1" d="M251 686 C224 691 219 659 187 651"/><path pathLength="1" d="M195 645 L187 651 L196 659"/></g><g class="drawn-arrow" stroke="#e989cb"><path pathLength="1" d="M636 778 Q692 768 747 774"/></g></svg></div></div><a class="scroll-cue" href="#spolecznosc" aria-label="Zobacz posty społeczności"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#icon-ArrowDown"></use></svg></a></section><section class="mission-section" aria-labelledby="mission-title"><div class="mission-inner"><h2 id="mission-title">Na hejt <span>nie ma</span> tu miejsca.</h2><p>Szanujemy twórców, użytkowników i różnorodność seksualności.<br>Rozmawiamy bez poniżania i oceniania.</p></div></section><main id="spolecznosc"><div class="atmosphere" aria-hidden="true"><div class="orb orb-one"></div><div class="orb orb-two"></div><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="spark spark-one">✦</div><div class="spark spark-two">✦</div></div><header class="heading"><h1>Poznaj ludzi.<span>Zobacz, o czym rozmawiają.</span></h1></header><div class="controls"><div class="arrows"><button class="arrow" id="prev" aria-label="Poprzednie posty"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#icon-ArrowLeft"></use></svg></button><button class="arrow" id="next" aria-label="Następne posty"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#icon-ArrowRight"></use></svg></button></div></div><section class="track" tabindex="0" aria-label="Wybrane posty społeczności" aria-roledescription="karuzela">
<% landing_posts.each do |p| %>
  <article class="card <%= p["video"] ? "video" : "text" %>">
    <% if p["video"] %>
      <div class="thumb">
        <picture><source srcset="<%= image_path("#{p["image"]}.webp") %>" type="image/webp">
        <img alt="Kadr materiału: <%= p["title"] %>" draggable="false" loading="lazy" decoding="async" src="<%= image_path("#{p["image"]}.png") %>" style="width:<%= p["width"] %>;left:<%= p["offset"] %>"></picture>
        <span class="play" aria-hidden="true"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#icon-Play"></use></svg></span>
        <% if p["duration"].present? %><span class="duration"><%= p["duration"] %></span><% end %>
      </div>
    <% end %>
    <div class="content">
      <div class="author">
        <% if p["avatar"] %><span class="avatar"><img alt="" loading="lazy" decoding="async" src="<%= image_path("#{p["image"]}.png") %>" style="<%= p["avatar_style"] %>"></span><% end %>
        <span><%= p["author"] %></span>
      </div>
      <p class="kind"><%= p["kind"] %></p>
      <h2><%= p["title"] %></h2>
      <% if p["tags"].present? %><div class="tags"><%= p["tags"] %></div><p class="meta"><%= p["meta"] %></p><% end %>
      <a class="read" href="<%= p["url"] %>"><%= p["note"] %><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#icon-ArrowUpRight"></use></svg></a>
    </div>
  </article>
<% end %>
</section><footer class="bottom"><div class="progress" aria-hidden="true"></div></footer></main><section class="toby-section final-toby" id="toby-ai" aria-labelledby="toby-title"><div class="toby-final-layout"><div class="toby-final-copy"><h2 id="toby-title">Toby <span>AI</span></h2><h3>Zapytaj po swojemu.</h3><p>O seksualności, relacjach i bliskości. Bez skrępowania.</p><form class="toby-composer" action="<%= sign_up_path %>" method="get" data-toby-composer action="/enter" method="get"><label class="sr-only" for="toby-question">Twoje pytanie do Toby AI</label><textarea id="toby-question" placeholder="Co kryjesz w sobie? ;)" rows="3" maxlength="2000"></textarea><button type="submit" class="ask-toby" aria-label="Przejdź do logowania, aby porozmawiać z Tobym"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#icon-ArrowUp"></use></svg></button></form><div class="question-starters"><button type="button">Jak rozmawiać o granicach?</button><button type="button">Jak powiedzieć, czego potrzebuję?</button></div></div><div class="toby-final-visual"><div class="toby-speech"><strong>Cześć! Tu Toby.</strong><span>Co chodzi Ci po głowie?</span></div><picture><source srcset="<%= image_path("landing/toby-listening.webp") %>" type="image/webp"><img class="toby-listening" src="<%= image_path("landing/toby-listening.jpg") %>" alt="Toby słucha z uśmiechem, trzymając łapkę przy policzku" loading="lazy" decoding="async"></picture></div></div></section><section class="rewards-section" id="educoiny" aria-labelledby="rewards-title"><div class="rewards-layout"><div class="rewards-left"><h2 id="rewards-title">Działaj.<br>Zbieraj Educoiny.<br><span>Odbieraj nagrody.</span></h2><p>Bądź aktywny na platformie, zbieraj Educoiny i wymieniaj je na gadżety od EasyToys.</p><div class="rewards-prize"><div class="reward-art mug-art" role="img" aria-label="Kubek #żyjebeztabu i złote Educoiny"></div><a class="rewards-button" href="/educoin">Zobacz inne gadżety<svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-ArrowRight"></use></svg></a></div></div><div class="rewards-right"><div class="challenge-heading"><h3>Podejmuj wyzwania.</h3><p>Organizujemy challenge, w których możesz zdobyć ekstra nagrody.</p></div><div class="reward-art challenge-art" role="img" aria-label="Odznaki challenge’y września, października i grudnia"></div><div class="achievement-group"><h3>Zdobywaj odznaki.</h3><div class="reward-art achievement-art" role="img" aria-label="Odznaki Królowie Debaty, Ukochany Komentarz i Writing Streak"></div></div></div></div></section><section class="profiles-section" id="polecane-profile" aria-labelledby="profiles-title"><div class="profiles-heading"><h2 id="profiles-title">Zobacz wybranych ekspertów</h2><div class="profile-controls"><button class="arrow" id="profiles-prev" aria-label="Poprzednie profile"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-ArrowLeft"></use></svg></button><button class="arrow" id="profiles-next" aria-label="Następne profile"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-ArrowRight"></use></svg></button></div></div><div class="profiles-track" tabindex="0" role="region" aria-roledescription="karuzela" aria-label="Polecane profile">
<% landing_profiles.each do |p| %>
  <% w, h, crop = p["W"].to_f, p["H"].to_f, p["crop"].to_f %>
  <article class="profile-card">
    <span class="profile-photo" role="img" aria-label="Awatar profilu <%= p["name"] %>"
          style="background-image:image-set(url(<%= image_path("#{p["src"]}.webp") %>) type('image/webp'), url(<%= image_path("#{p["src"]}.png") %>) type('image/png'));background-size:<%= (w / crop * 100).round(2) %>% <%= (h / crop * 100).round(2) %>%;background-position:<%= (p["x"].to_f / (w - crop) * 100).round(2) %>% <%= (p["y"].to_f / (h - crop) * 100).round(2) %>%"></span>
    <h3><%= p["name"] %></h3>
    <span class="profile-handle">@<%= p["handle"] %></span>
    <p class="profile-description"><%= p["description"] %></p>
    <a class="profile-link" href="/<%= p["handle"] %>">Zobacz profil<svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#icon-ArrowUpRight"></use></svg></a>
  </article>
<% end %>
</div><div class="profiles-position" aria-hidden="true"><i class="active"></i><i></i><i></i><i></i></div></section><section class="topics-section" id="tematy" aria-labelledby="topics-title"><div class="topics-inner"><h2 id="topics-title">Znajdź swój temat<span>.</span></h2><div class="topics-directory"><div class="topics-grid">
<% landing_topics.each do |t| %>
  <% if t["faded"] %>
    <div class="<%= t["css_class"] %>" aria-hidden="true">
      <div class="topic-title"><span class="topic-hash">#</span><%= t["label"] %></div>
      <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#icon-ArrowUpRight"></use></svg>
      <p><%= t["description"] %></p>
    </div>
  <% else %>
    <a class="<%= t["css_class"] %>" href="/t/<%= t["slug"] %>">
      <div class="topic-title"><span class="topic-hash">#</span><%= t["label"] %></div>
      <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#icon-ArrowUpRight"></use></svg>
      <p><%= t["description"] %></p>
    </a>
  <% end %>
<% end %>
</div><div class="topics-veil" aria-hidden="true"></div><div class="topics-invite"><h3>Nie widzisz swojego tematu?</h3><p>Załóż go i zbuduj swoją społeczność.</p><a class="topic-create" href="<%= sign_up_path %>">Załóż swój temat<svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-ArrowRight"></use></svg></a></div></div></div></section><section class="events-section" id="wydarzenia" aria-labelledby="events-title"><div class="event-banner"><div class="event-photo" aria-hidden="true"><picture><source srcset="<%= image_path("landing/event-party.webp") %>" type="image/webp"><img src="<%= image_path("landing/event-party.jpg") %>" alt="" loading="lazy" decoding="async" width="1774" height="887"></picture></div><div class="event-copy"><h2 id="events-title">Organizujesz<br>event?</h2><p>Zrób go<br>przez nietabu.</p><a class="event-cta" href="<%= sign_up_path %>">Dodaj wydarzenie<svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-ArrowRight"></use></svg></a></div></div></section><section class="closing-section" id="dolacz" aria-labelledby="closing-title"><div class="closing-inner"><div class="closing-copy"><h2 id="closing-title">Miejsce<br>dla Ciebie.</h2><p class="closing-hashtag">#żyjebeztabu</p><div class="closing-actions"><a class="primary" href="<%= sign_up_path(state: "new-user") %>">Dołącz do nas</a><a class="secondary" href="<%= sign_up_path %>">Zaloguj się</a></div><div class="apps"><p>Pobierz aplikację</p><div><a class="store-badge" href="https://apps.apple.com/pl/app/nie-tabu/id6756076077" aria-label="Pobierz w App Store"><span class="store-crop apple-crop" aria-hidden="true"></span><span class="sr-only">App Store</span></a><% if google_play_url.present? %><a class="store-badge" href="<%= google_play_url %>" rel="noopener"><span class="store-crop google-crop" aria-hidden="true"></span><span class="sr-only">Pobierz z Google Play</span></a><% end %></div></div></div><div class="closing-phone" role="img" aria-label="Podgląd aplikacji nietabu z postem społeczności i komentarzem Toby’ego"></div></div></section><footer class="site-footer"><div class="site-footer-inner"><a href="#" aria-label="nietabu — początek strony"><picture><source srcset="<%= image_path("landing/logo.webp") %>" type="image/webp"><img class="footer-brand" src="<%= image_path("landing/logo.png") %>" alt="nietabu" loading="lazy" decoding="async"></picture></a><nav aria-label="Linki w stopce"><a href="/contact">Kontakt</a><a href="/terms">Regulamin</a><a href="/privacy">Prywatność</a><a href="/code-of-conduct">Kodeks społeczności</a><a href="https://www.instagram.com/nietabu.pl/" target="_blank" rel="noopener noreferrer">Instagram</a></nav></div></footer>