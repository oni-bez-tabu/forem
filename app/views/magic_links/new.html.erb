<style>
.start-wrapper {
  height: 100dvh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  padding-top: calc(env(safe-area-inset-top));
  padding-bottom: calc(env(safe-area-inset-bottom) + 16px);
}
.alternate-links {
  text-align: center;
  font-weight: bold;
  text-decoration: underline;
  font-size: 1.15em;
  line-height: 1.5em;
}
html, body {
  height: 100%;
  overflow: hidden;
}
#main-content {
  min-height: 100dvh;
}
body {
  background-color: #fff !important;
}
.crayons-card {
  box-shadow: none !important;
  border: 0 !important;
  background: transparent !important;
  margin: 0 auto !important;
}
@media (max-width: 600px) {
  .crayons-card {
    margin-top: 0 !important;
    max-height: calc(100dvh - 32px - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  }
}

.logo-area {
  text-align: center;
  margin: 0 auto;
}
</style>

<main id="main-content">
  <div class="start-wrapper">
    <div class="crayons-card text-padding"
         style="width: 100%; max-width: 560px; margin: 0 auto;">
      <% if Settings::General.original_logo.present? %>
        <div class="logo-area">
          <img class="registration__logo" src="<%= Settings::General.original_logo %>" alt="<%= community_name %>">
        </div>
      <% end %>
      <!-- Main heading -->
      <h2 class="text-center pt-4" style="padding: 24px 0 8px; font-size: clamp(20px, 2.4vw, 28px); line-height: 1.3;">
        Zaloguj się lub utwórz konto za pomocą jednorazowego kodu
      </h2>

      <!-- Subheader / description 
      <p class="magic-subheader text-center pb-4" style="max-width: 600px; margin: 0 auto 2vh;font-size: 1.1em;">
        Kod działa nawet jeśli wcześniej zarejestrowałeś się używając uwierzytelniania zewnętrznego <span style="display:inline-block"> — o ile używasz tego samego adresu email</span>.
      </p>
      -->
      <!-- Magic link form -->
      <%= form_with url: magic_links_path, method: :post, local: true do |f| %>
        <div class="crayons-field pb-2">
          <%= f.email_field :email,
                class: "crayons-textfield fs-2xl",
                value: params[:email],
                placeholder: "Adres email",
                required: true,
                autofocus: true %>
        </div>
        <div class="crayons-field py-2">
          <%= f.submit "Wyślij mi kod",
                class: "crayons-btn py-6 fs-xl fw-bold" %>
        </div>
        <div class="alternate-links pt-3 pb-6">
            <%= link_to "Masz już kod?", new_magic_link_path(state: "code"), class: "crayons-link fs-s my-2 block" %>
        </div>
      <% end %>

      <!-- Simple alternate links -->
      <div class="alternate-links pt-8 pb-8">
        <%= link_to "Zarejestruj się tradycyjnie", "/enter?state=new-user", class: "crayons-link fs-md my-2 block" %>
        <%= link_to "Zaloguj się tradycyjnie", "/enter", class: "crayons-link fs-md my-2 block" %>
      </div>
      <div class="mt-4 align-center fs-s fw-normal fs-italic px-0 s:px-9 color-secondary">
        <%= t("devise.registrations.agreement.sign_up_html", privacy_path: privacy_path, terms_path: terms_path, code_of_conduct_path: code_of_conduct_path) %>
      </div>
    </div>
  </div>
</main>
