<style>
.start-wrapper {
  height: 100dvh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  padding-top: calc(env(safe-area-inset-top));
  padding-bottom: calc(env(safe-area-inset-bottom) + 16px);
}
html, body {
  height: 100%;
  overflow: hidden;
}
#main-content {
  min-height: 100dvh;
}
body {
  background-color: var(--body-bg) !important;
}
.crayons-card {
  box-shadow: none !important;
  border: 0 !important;
  background: transparent !important;
  margin: 0 auto !important;
}
.logo-area {
  text-align: center;
  margin: 0 auto;
}
</style>

<main id="main-content">
  <div class="start-wrapper">
    <div class="crayons-card text-padding" style="width: 100%; max-width: 560px; margin: 0 auto;">
      <% if Settings::General.original_logo.present? %>
        <div class="logo-area">
          <img class="registration__logo" src="<%= Settings::General.original_logo %>" alt="<%= community_name %>">
        </div>
      <% end %>

      <h2 class="text-center pt-4" style="padding: 24px 0 8px; font-size: clamp(20px, 2.4vw, 28px); line-height: 1.3;">
        Wpisz kod z e‑maila
      </h2>

      <form action="/magic_links/show_placeholder" method="GET" id="code-entry-form">
        <div class="crayons-field pb-2">
          <input type="text" id="email-code" name="id" required
                 class="crayons-textfield fs-2xl"
                 placeholder="Wpisz kod">
        </div>
        <div class="crayons-field py-2">
          <button type="submit" class="crayons-btn py-6 fs-xl fw-bold">
            Zaloguj się kodem
          </button>
        </div>
      </form>

      <p class="py-4">Kod pozostanie ważny przez 20 minut.</p>

      <script>
        const form = document.getElementById('code-entry-form');
        const codeInput = document.getElementById('email-code');
        const baseUrl = form.action.replace('/show_placeholder', '');
        form.addEventListener('submit', function(event) {
          event.preventDefault();
          const code = codeInput.value.trim();
          if (code) {
            const finalUrl = `${baseUrl}/${encodeURIComponent(code)}`;
            window.location.href = finalUrl;
          } else {
            alert('Wpisz kod z e‑maila.');
          }
        });
      </script>
    </div>
  </div>
</main>
